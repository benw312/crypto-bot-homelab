# Copy to .env and adjust. Docker Compose reads .env automatically.

# --- Main stack (TimescaleDB microservices) ---
DB_PASSWORD=change-me
DB_PORT=5432   # host port for TimescaleDB; change if 5432 is taken

# --- Legacy Raspberry Pi build (legacy/) only ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:Sentiment Tracker:v1.0
TWITTER_BEARER_TOKEN=
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8086
INFLUXDB_USERNAME=
INFLUXDB_PASSWORD=
INFLUXDB_DB=crypto
ALERT_EMAIL_ADDRESS=
ALERT_EMAIL_PASSWORD=
ALERT_RECIPIENT_EMAIL=
BACKUP_S3_BUCKET=
